#pragma code_page(65001)
#include <windows.h>
#include "resource.h"
1 RT_MANIFEST "app.manifest"
IDD_OPEN DIALOGEX 0,0,340,108
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "打开 B 站攻略"
FONT 9,"Microsoft YaHei UI"
BEGIN
 LTEXT "粘贴视频链接或 BV 号，支持指定分 P 和 b23.tv 短链接。",-1,12,12,316,20
 EDITTEXT IDC_URL,12,36,316,16,ES_AUTOHSCROLL
 LTEXT "打开后可在“选集”中切换路线，观看进度会自动保存。",-1,12,59,316,14
 DEFPUSHBUTTON "播放",IDOK,219,82,52,16
 PUSHBUTTON "取消",IDCANCEL,277,82,51,16
END
IDD_PARTS DIALOGEX 0,0,450,288
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "选择攻略路线"
FONT 9,"Microsoft YaHei UI"
BEGIN
 LTEXT "选择分 P，双击或按 Enter 播放；每一 P 分别记住进度。",-1,12,10,426,14
 LISTBOX IDC_PARTLIST,12,30,426,216,LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
 DEFPUSHBUTTON "播放选中",IDOK,319,258,60,18
 PUSHBUTTON "取消",IDCANCEL,385,258,53,18
END
IDD_SETTINGS DIALOGEX 0,0,340,288
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "小窗设置"
FONT 9,"Microsoft YaHei UI"
BEGIN
 LTEXT "画质上限",-1,12,14,60,14
 COMBOBOX IDC_QUALITY,82,12,90,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "音量",-1,184,14,35,14
 EDITTEXT IDC_VOLUME,225,12,45,16,ES_NUMBER | ES_AUTOHSCROLL
 LTEXT "0–100",-1,278,14,45,14
 LTEXT "只选择实际可用的画质；降低分辨率可减少解码开销。",-1,12,38,316,18
 LTEXT "快捷键（点击后直接按下新组合键）",-1,12,63,316,16
 LTEXT "鼠标穿透",-1,20,89,100,14
 CONTROL "",1010,"msctls_hotkey32",WS_TABSTOP,145,85,170,18
 LTEXT "隐藏 / 显示",-1,20,115,100,14
 CONTROL "",1011,"msctls_hotkey32",WS_TABSTOP,145,111,170,18
 LTEXT "暂停 / 继续",-1,20,141,100,14
 CONTROL "",1012,"msctls_hotkey32",WS_TABSTOP,145,137,170,18
 LTEXT "倒退 5 秒",-1,20,167,100,14
 CONTROL "",1013,"msctls_hotkey32",WS_TABSTOP,145,163,170,18
 LTEXT "前进 5 秒",-1,20,193,100,14
 CONTROL "",1014,"msctls_hotkey32",WS_TABSTOP,145,189,170,18
 LTEXT "登录信息（可选，cookies.txt；留空使用公开画质）",-1,12,217,316,14
 EDITTEXT IDC_COOKIES,12,234,254,16,ES_AUTOHSCROLL
 PUSHBUTTON "选择…",IDC_BROWSE,273,234,55,16
 DEFPUSHBUTTON "保存",IDOK,219,263,52,16
 PUSHBUTTON "取消",IDCANCEL,277,263,51,16
END
